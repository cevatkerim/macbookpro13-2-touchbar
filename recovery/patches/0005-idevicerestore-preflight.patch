index 0000000..43263fe
--- /dev/null
+++ b/tests/preflight_harness.c
@@ -0,0 +1,67 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * Link the real preflight implementation with local fixture providers only.
+ * No USB sender, boot, restored, or reverse-proxy implementation is linked.
+ */
+#include "t1.h"
+#include "recovery.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static const char *fixture;
+static int fail_signing;
+static unsigned char nonce[] = {1,2,3};
+static struct irecv_device_info info = {.ap_nonce=nonce,.ap_nonce_size=3,
+                                       .sep_nonce=nonce,.sep_nonce_size=3};
+const struct irecv_device_info *irecv_get_device_info(irecv_client_t client)
+{ (void)client; return &info; }
+
+int extract_component(ipsw_archive_t archive, const char *name, void **data, size_t *size)
+{
+    (void)archive;
+    char path[1024];snprintf(path,sizeof(path),"%s/%s",fixture,name);
+    FILE *f=fopen(path,"rb");if(!f)return -1;
+    fseek(f,0,SEEK_END);long n=ftell(f);rewind(f);
+    if(n<=0){fclose(f);return -1;}
+    *data=malloc(n);*size=n;
+    if(!*data){fclose(f);return -1;}
+    int ok=fread(*data,1,n,f)==(size_t)n;fclose(f);
+    if(!ok){free(*data);*data=NULL;return -1;}return 0;
+}
+int build_identity_get_component_path(plist_t identity,const char *name,char **path)
+{ (void)identity; *path=strdup(name);return *path?0:-1; }
+int personalize_component(struct idevicerestore_client_t *client,const char *name,
+ const void *raw,size_t size,plist_t tss,void **out,size_t *out_size)
+{
+    (void)client;(void)name;(void)tss;
+    *out=malloc(size);if(!*out)return -1;
+    memcpy(*out,raw,size);*out_size=size;return 0;
+}
+int get_tss_response(struct idevicerestore_client_t *client,plist_t identity,plist_t *tss)
+{
+    (void)client;(void)identity;
+    if(fail_signing)return -1;
+    void *ticket=NULL;size_t size=0;
+    if(extract_component(NULL,"Ticket",&ticket,&size))return -1;
+    *tss=plist_new_dict();plist_dict_set_item(*tss,"ApImg4Ticket",plist_new_data(ticket,size));
+    free(ticket);return 0;
+}
+int main(int argc,char **argv)
+{
+    if(argc!=4)return 2;
+    fixture=argv[1];fail_signing=atoi(argv[3]);
+    int fd=t1_private_open(argv[2]);if(fd<0)return 3;
+    struct recovery_client_t r={0};
+    struct idevicerestore_client_t c={.ecid=123,.recovery=&r};
+    int rc=t1_preflight(&c,NULL,fd);
+    free(c.nonce);plist_free(c.tss);close(fd);
+    return rc?1:0;
+}
+
+int tss_response_get_ap_img4_ticket(plist_t tss, unsigned char **ticket, unsigned int *size)
+{
+    uint64_t n=0;char *data=NULL;
+    plist_get_data_val(plist_dict_get_item(tss,"ApImg4Ticket"),&data,&n);
+    if(!data||!n||n>1024*1024){free(data);return -1;}
+    *ticket=(unsigned char *)data;*size=n;return 0;
+}
