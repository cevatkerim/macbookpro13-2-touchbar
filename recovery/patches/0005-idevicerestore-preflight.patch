+                (source/name).write_bytes(image(tag))
+            env=dict(os.environ,LD_LIBRARY_PATH=str(PREFIX/'lib'))
+            for fail in [1,0]:
+                result=subprocess.run([str(self.binary),str(source),str(dest),str(fail)],env=env)
+                self.assertEqual(result.returncode,fail)
+                if fail:self.assertEqual(list(dest.iterdir()),[])
+            result=plistlib.loads((dest/'preflight-only.plist').read_bytes())
+            self.assertFalse(result['RestoreFinished'])
+            self.assertEqual(dispatch(result),(-1,[]))
+            self.assertFalse((dest/'preflight.plist').exists())
+            self.assertFalse((dest/'FDRData').exists())
+
 class CommandLine(unittest.TestCase):
     def setUp(self):
         self.tmp=tempfile.TemporaryDirectory();self.path=Path(self.tmp.name)
