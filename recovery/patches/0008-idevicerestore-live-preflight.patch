             self.assertFalse((dest/'preflight.plist').exists())
             self.assertFalse((dest/'FDRData').exists())
 
+class Launcher(unittest.TestCase):
+    def test_explicit_hex_ecid_is_accepted_by_base_zero_parser(self):
+        spec=importlib.util.spec_from_file_location('t1_launcher',ROOT/'scripts/t1-run.py')
+        launcher=importlib.util.module_from_spec(spec);spec.loader.exec_module(launcher)
+        argv=['t1-run.py','preflight','/fixture','--prefix',str(PREFIX),'--private','/private']
+        with mock.patch('sys.argv',argv),mock.patch.object(launcher,'select_ecid',return_value=0x123abcd), \
+             mock.patch.object(launcher.os,'geteuid',return_value=0), \
+             mock.patch.object(launcher.subprocess,'run',return_value=mock.Mock(returncode=0)) as run:
+            self.assertEqual(launcher.main(),0)
+        command=run.call_args.args[0]
+        self.assertEqual(int(command[command.index('-i')+1],0),0x123abcd)
+
 class CommandLine(unittest.TestCase):
     def setUp(self):
         self.tmp=tempfile.TemporaryDirectory();self.path=Path(self.tmp.name)
@@ -229,6 +243,12 @@ class CommandLine(unittest.TestCase):
     def test_inspect_compiled_binary(self):
         result=self.run_cli();self.assertEqual(result.returncode,0,result.stderr)
         self.assertIn('offline inspection passed',result.stdout)
+    def test_bad_ecid_is_not_echoed(self):
+        value="123abcd-invalid-fixture"
+        result=self.run_cli(["-i",value])
+        self.assertNotEqual(result.returncode,0)
+        self.assertNotIn(value,result.stdout+result.stderr)
+        self.assertIn("Could not parse T1 ECID",result.stdout+result.stderr)
     def test_reject_missing_component(self):
         (self.path/'SEP.im4p').unlink()
         self.assertNotEqual(self.run_cli().returncode,0)
