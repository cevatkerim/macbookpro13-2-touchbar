+class Plist:
+    def __init__(self, obj):
+        raw = plistlib.dumps(obj, fmt=plistlib.FMT_BINARY, sort_keys=False)
+        self.ptr = C.c_void_p()
+        p.plist_from_bin(raw, len(raw), C.byref(self.ptr))
+        assert self.ptr
+    def __enter__(self): return self.ptr
+    def __exit__(self, *args): p.plist_free(self.ptr)
+
+def decode(ptr):
+    out = C.c_void_p(); size = C.c_uint32()
+    p.plist_to_bin(ptr, C.byref(out), C.byref(size))
+    data = C.string_at(out, size.value)
+    p.plist_mem_free(out)
+    return plistlib.loads(data)
+
+def der(tag, data):
+    n = len(data)
+    size = bytes([n]) if n < 128 else bytes([0x80+(n.bit_length()+7)//8])+n.to_bytes((n.bit_length()+7)//8, 'big')
+    return bytes([tag])+size+data
+
+def text(s): return der(0x16, s.encode())
+TICKET = der(0x30, text('IM4M') + der(0x04, b'synthetic ticket'))
+def image(tag, ticket=TICKET):
+    payload = der(0x30, text('IM4P')+text(tag)+text('test')+der(0x04, b'test payload'))
+    return der(0x30, text('IMG4')+payload+der(0xa0, ticket))
+def pair():
