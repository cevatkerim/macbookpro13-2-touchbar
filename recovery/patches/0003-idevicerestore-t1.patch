+#ifndef IDEVICERESTORE_T1_H
+#define IDEVICERESTORE_T1_H
+#include "common.h"
+
+/* Independent experimental entry point; never falls back to generic restore. */
+int t1_requested(void);
+int t1_start(struct idevicerestore_client_t *client);
+plist_t t1_restore_options(void);
+int t1_identity_valid(plist_t manifest, plist_t identity);
+int t1_request_allowed(const char *type);
+int t1_private_open(const char *path);
+int t1_atomic_write(int dirfd, const char *name, const void *data, size_t size);
+int t1_read_private(int dirfd, const char *name, void **data, size_t *size);
+int t1_fdr_commit(int dirfd, plist_t message);
+int t1_validate_pair(plist_t pair, uint64_t ecid);
+int t1_validate_img4(const void *data, size_t size, const char *tag,
+                     const void *ticket, size_t ticket_size);
+typedef int (*t1_command_fn)(void *, const char *, int);
+typedef int (*t1_buffer_fn)(void *, const void *, size_t);
+int t1_replay_dispatch(plist_t pair, uint64_t ecid, uint64_t now, void *transport,
