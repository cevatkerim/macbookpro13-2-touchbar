+            'RestoreFinished':True, 'FDRReplayed':True, 'FinishedAt':100}
+
+def dispatch(obj, fail_at=None, now=110):
+    calls=[]
+    def cmd(_, name, breq):
+        calls.append(('command',name.decode(),breq))
+        return -1 if len(calls)==fail_at else 0
+    def buf(_, data, size):
+        calls.append(('buffer',C.string_at(data,size)))
+        return -1 if len(calls)==fail_at else 0
+    with Plist(obj) as ptr:
+        rc=lib.t1_replay_dispatch(ptr,123,now,None,COMMAND(cmd),BUFFER(buf))
+    return rc,calls
