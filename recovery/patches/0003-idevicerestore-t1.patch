diff --git a/src/t1_policy.c b/src/t1_policy.c
new file mode 100644
index 0000000..927280a
--- /dev/null
+++ b/src/t1_policy.c
@@ -0,0 +1,246 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * Experimental T1 policy, private storage and bounded IMG4 validation.
+ * No USB or network access in this translation unit.
+ */
+#include "t1.h"
+#include <errno.h>
+#include <fcntl.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+#include <sys/stat.h>
+
+#define T1_MAX_FILE (128u * 1024u * 1024u)
+
+static int string_is(plist_t p, const char *s)
+{
+    return PLIST_IS_STRING(p) && !strcmp(plist_get_string_ptr(p, NULL), s);
+}
+
+int t1_identity_valid(plist_t manifest, plist_t identity)
+{
+    return string_is(plist_dict_get_item(manifest, "ProductVersion"), "3.0") &&
+        string_is(plist_dict_get_item(manifest, "ProductBuildVersion"), "14Y901") &&
+        string_is(plist_access_path(identity, 2, "Info", "DeviceClass"), "x619ap") &&
+        string_is(plist_access_path(identity, 2, "Info", "Variant"), "Customer Boot") &&
+        plist_dict_get_uint(identity, "ApChipID") == 0x8002 &&
+        plist_dict_get_uint(identity, "ApBoardID") == 0x12 &&
+        !plist_dict_get_item(manifest, "SupportedProductTypes") &&
+        !plist_dict_get_item(plist_dict_get_item(identity, "Manifest"), "OS");
+}
+
+int t1_request_allowed(const char *type)
+{
+    static const char *allowed[] = {"NORData", "RootTicket", "FDRTrustData",
+                                   "FDRMemoryCommit", "FUDData", NULL};
+    for (int i = 0; type && allowed[i]; i++)
+        if (!strcmp(type, allowed[i])) return 1;
+    return 0;
+}
+
+plist_t t1_restore_options(void)
+{
+    plist_t p = plist_new_dict();
+    plist_dict_set_item(p, "ApBootstrapOnly", plist_new_bool(0));
+    plist_dict_set_item(p, "PersonalizedDuringPreflight", plist_new_bool(1));
+    plist_dict_set_item(p, "FlashNOR", plist_new_bool(1));
+    plist_dict_set_item(p, "ShouldRestoreSystemImage", plist_new_bool(0));
+    plist_dict_set_item(p, "CreateFilesystemPartitions", plist_new_bool(0));
+    plist_dict_set_item(p, "UpdateBaseband", plist_new_bool(0));
+    plist_dict_set_item(p, "RestoreBootArgs", plist_new_string(
+        "rd=md0 -restore IOUSBDeviceController-configuration=standardMuxOnly"));
+    return p;
+}
+
+static int filename_valid(const char *name)
+{
+    return name && *name && strlen(name) < 160 && !strchr(name, '/') &&
+        strcmp(name, ".") && strcmp(name, "..");
+}
+
+int t1_private_open(const char *path)
+{
+    /* Walk each component without following symlinks, including ancestors. */
+    if (!path || path[0] != '/') return -1;
+    char *copy = strdup(path), *save = NULL;
+    if (!copy) return -1;
+    int fd = open("/", O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    for (char *p = strtok_r(copy, "/", &save); fd >= 0 && p;
+         p = strtok_r(NULL, "/", &save)) {
+        if (!strcmp(p, ".") || !strcmp(p, "..")) { close(fd); fd = -1; break; }
+        int next = openat(fd, p, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+        close(fd);
+        fd = next;
+    }
+    free(copy);
+    struct stat st;
+    if (fd >= 0 && (fstat(fd, &st) || st.st_uid != geteuid() || (st.st_mode & 0777) != 0700)) {
+        close(fd);
+        fd = -1;
+    }
+    return fd;
+}
+
+int t1_atomic_write(int dirfd, const char *name, const void *data, size_t size)
+{
+    if (!filename_valid(name) || !data || !size || size > T1_MAX_FILE) return -1;
+    struct stat st;
+    if (!fstatat(dirfd, name, &st, AT_SYMLINK_NOFOLLOW)) {
+        if (!S_ISREG(st.st_mode) || st.st_uid != geteuid() || st.st_nlink != 1 ||
+            (st.st_mode & 0777) != 0600) return -1;
+    } else if (errno != ENOENT) return -1;
+    static unsigned sequence;
+    char tmp[200];
+    snprintf(tmp, sizeof(tmp), ".%s.%ld.%u.tmp", name, (long)getpid(), sequence++);
+    int fd = openat(dirfd, tmp, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600);
+    if (fd < 0) return -1;
+    size_t offset = 0;
+    int rc = -1;
+    while (offset < size) {
+        ssize_t n = write(fd, (const char *)data + offset, size - offset);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) goto done;
+        offset += n;
+    }
+    if (fsync(fd)) goto done;
+    if (close(fd)) { fd = -1; goto done; }
+    fd = -1;
+    if (renameat(dirfd, tmp, dirfd, name) || fsync(dirfd)) goto done;
+    rc = 0;
+ done:
+    if (fd >= 0) close(fd);
+    if (rc) unlinkat(dirfd, tmp, 0);
+    return rc;
+}
+
+int t1_read_private(int dirfd, const char *name, void **data, size_t *size)
+{
+    *data = NULL; *size = 0;
+    if (!filename_valid(name)) return -1;
+    int fd = openat(dirfd, name, O_RDONLY | O_NOFOLLOW | O_CLOEXEC | O_NONBLOCK);
+    struct stat st;
+    if (fd < 0) return -1;
+    if (fstat(fd, &st) || !S_ISREG(st.st_mode) || st.st_uid != geteuid() ||
+        st.st_nlink != 1 || (st.st_mode & 0777) != 0600 ||
+        st.st_size <= 0 || st.st_size > T1_MAX_FILE) { close(fd); return -1; }
+    char *buf = malloc(st.st_size);
+    if (!buf) { close(fd); return -1; }
+    size_t off = 0;
+    while (off < (size_t)st.st_size) {
+        ssize_t n = read(fd, buf + off, st.st_size - off);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) { free(buf); close(fd); return -1; }
+        off += n;
+    }
+    char extra;
+    if (read(fd, &extra, 1) != 0) { free(buf); close(fd); return -1; }
+    close(fd);
+    *data = buf; *size = off;
+    return 0;
+}
+
+int t1_fdr_commit(int dirfd, plist_t message)
+{
+    /* The runbook does not publish a wire capture. These two explicitly named
+     * store envelopes are provisional; reject absent/ambiguous/empty stores.
+     * Never mistake the complete request envelope for device FDR data. */
+    plist_t store = NULL;
+    const char *keys[] = {"FDRMemoryStore", "FDRMemoryStoreData"};
+    for (int level = 0; level < 2; level++) {
+        plist_t parent = level ? plist_dict_get_item(message, "Arguments") : message;
+        for (int k = 0; k < 2; k++) {
+            plist_t candidate = plist_dict_get_item(parent, keys[k]);
+            if (candidate) {
+                if (store || !PLIST_IS_DICT(candidate) || !plist_dict_get_size(candidate)) return -1;
+                store = candidate;
+            }
+        }
+    }
+    if (!store) return -1;
+    char *bin = NULL; uint32_t len = 0;
+    plist_to_bin(store, &bin, &len);
+    int rc = t1_atomic_write(dirfd, "FDRData", bin, len);
+    plist_mem_free(bin);
+    return rc;
+}
+
+/* Definite DER lengths only, with bounds checked before every read. */
+static int der(const unsigned char **cursor, const unsigned char *end,
+               unsigned char tag, const unsigned char **value, size_t *size)
+{
+    const unsigned char *p = *cursor;
+    if (end - p < 2 || *p++ != tag) return -1;
+    size_t n = *p++;
+    if (n & 0x80) {
+        size_t count = n & 0x7f;
+        if (!count || count > 4 || (size_t)(end - p) < count || !*p) return -1;
+        n = 0;
+        while (count--) n = (n << 8) | *p++;
+        if (n < 128) return -1;
+    }
+    if (n > (size_t)(end - p)) return -1;
+    *value = p; *size = n; *cursor = p + n;
+    return 0;
+}
+
+static int der_text(const unsigned char **p, const unsigned char *end, const char *s)
+{
+    const unsigned char *v; size_t n;
+    return der(p, end, 0x16, &v, &n) || n != strlen(s) || memcmp(v, s, n) ? -1 : 0;
+}
+
+int t1_validate_img4(const void *data, size_t size, const char *tag,
+                     const void *ticket, size_t ticket_size)
+{
+    if (!data || !size || size > T1_MAX_FILE || !ticket || !ticket_size) return -1;
+    const unsigned char *p = data, *end = p + size, *v; size_t n;
+    if (der(&p, end, 0x30, &v, &n) || p != end) return -1;
+    p = v; end = v + n;
+    if (der_text(&p, end, "IMG4") || der(&p, end, 0x30, &v, &n)) return -1;
+    const unsigned char *payload = v, *payload_end = v + n;
+    if (der_text(&payload, payload_end, "IM4P") || der_text(&payload, payload_end, tag)) return -1;
+    if (der(&p, end, 0xa0, &v, &n) || n != ticket_size || memcmp(v, ticket, n)) return -1;
+    /* This T1 format uses no IM4R/nonce-slot trailer. */
+    return p == end ? 0 : -1;
+}
+
+int t1_validate_pair(plist_t pair, uint64_t ecid)
+{
+    if (!PLIST_IS_DICT(pair) || !ecid || plist_dict_get_uint(pair, "ECID") != ecid ||
+        plist_dict_get_uint(pair, "FormatVersion") != 1 ||
+        !string_is(plist_dict_get_item(pair, "Build"), "14Y901") ||
+        !string_is(plist_dict_get_item(pair, "Model"), "x619ap")) return -1;
+    uint64_t image_len = 0, ticket_len = 0;
+    const char *image = plist_get_data_ptr(plist_dict_get_item(pair, "Image"), &image_len);
+    const char *ticket = plist_get_data_ptr(plist_dict_get_item(pair, "Ticket"), &ticket_len);
+    if (!image || !ticket || !image_len || image_len > T1_MAX_FILE || !ticket_len || ticket_len > 1024 * 1024) return -1;
+    const unsigned char *p = (const unsigned char *)image, *end = p + image_len;
+    const char *tags[] = {"osrd", "krnl", "dtre", "sepi"};
+    for (int i = 0; i < 4; i++) {
+        const unsigned char *start = p, *v; size_t n;
+        if (der(&p, end, 0x30, &v, &n) || t1_validate_img4(start, p - start, tags[i], ticket, ticket_len)) return -1;
+    }
+    return p == end ? 0 : -1;
+}
+
+int t1_replay_dispatch(plist_t pair, uint64_t ecid, uint64_t now, void *transport,
+                       t1_command_fn command, t1_buffer_fn buffer)
+{
+    /* Validate all artifacts before the first device mutation. No fresh TSS. */
+    if (!command || !buffer || t1_validate_pair(pair, ecid) ||
+        !PLIST_IS_BOOLEAN(plist_dict_get_item(pair, "RestoreFinished")) ||
+        !PLIST_IS_BOOLEAN(plist_dict_get_item(pair, "FDRReplayed")) ||
+        !plist_dict_get_bool(pair, "RestoreFinished") ||
+        !plist_dict_get_bool(pair, "FDRReplayed")) return -1;
+    uint64_t finished = plist_dict_get_uint(pair, "FinishedAt");
+    if (!finished || now < finished || now - finished < 10) return -1;
+    uint64_t tn = 0, in = 0;
+    const void *ticket = plist_get_data_ptr(plist_dict_get_item(pair, "Ticket"), &tn);
+    const void *image = plist_get_data_ptr(plist_dict_get_item(pair, "Image"), &in);
+    if (command(transport, "setenv auto-boot false", 0) ||
+        command(transport, "saveenv", 0) || buffer(transport, ticket, tn) ||
+        command(transport, "ticket", 0) || buffer(transport, image, in) ||
+        command(transport, "setenv boot-args rd=md0", 0) ||
+        command(transport, "memboot", 1)) return -1;
+    return 0;
+}
