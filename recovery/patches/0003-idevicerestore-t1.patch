diff --git a/src/t1.c b/src/t1.c
new file mode 100644
index 0000000..84ecbac
--- /dev/null
+++ b/src/t1.c
@@ -0,0 +1,415 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * Independent implementation of the experimental x619ap/14Y901 runbook.
+ * Not the author's unpublished patch. Hardware validation remains required.
+ */
+#include "t1.h"
+#include "recovery.h"
+#include "restore.h"
+#include "ipsw.h"
+#include <libtatsu/tss.h>
+#include <libimobiledevice/reverse_proxy.h>
+#include <fcntl.h>
+#include <stdatomic.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+#include <time.h>
+#include <sys/stat.h>
+
+extern char **environ;
+static int status_fd = -1;
+static void status(const char *s) { if (status_fd >= 0) dprintf(status_fd, "T1: %s\n", s); }
+
+int t1_requested(void)
+{
+    for (char **p = environ; p && *p; p++)
+        if (!strncmp(*p, "IDEVICERESTORE_T1_", 18)) return 1;
+    return 0;
+}
+
+static plist_t read_plist(int fd, const char *name)
+{
+    void *data = NULL; size_t size = 0; plist_t p = NULL;
+    if (!t1_read_private(fd, name, &data, &size)) {
+        if (size >= 8 && !memcmp(data, "bplist00", 8)) plist_from_bin(data, size, &p);
+        free(data);
+    }
+    return p;
+}
+
+static int save_plist(int fd, const char *name, plist_t p)
+{
+    char *data = NULL; uint32_t size = 0;
+    plist_to_bin(p, &data, &size);
+    int rc = t1_atomic_write(fd, name, data, size);
+    plist_mem_free(data);
+    return rc;
+}
+
+static int send_dict(struct idevicerestore_client_t *c, plist_t p)
+{
+    int rc = restored_send(c->restore->client, p) == RESTORE_E_SUCCESS ? 0 : -1;
+    plist_free(p);
+    return rc;
+}
+
+/* Upstream's raw command helper discards the USB transfer result. */
+static int strict_command(irecv_client_t r, const char *cmd, int breq)
+{
+    if (global_quit_flag) return -1;
+    size_t size = strlen(cmd) + 1;
+    if (size > 256) return -1;
+    return irecv_usb_control_transfer(r, 0x40, breq, 0, 0,
+        (unsigned char *)cmd, size, 10000) == (int)size ? 0 : -1;
+}
+
+static int send_component_command(struct idevicerestore_client_t *c,
+                                  plist_t identity, const char *component_name, const char *cmd)
+{
+    return recovery_send_component(c, identity, component_name) ||
+        strict_command(c->recovery->client, cmd, 0) ? -1 : 0;
+}
+
+static int open_recovery(struct idevicerestore_client_t *c)
+{
+    irecv_client_t r = NULL;
+    if (irecv_open_with_ecid(&r, c->ecid) != IRECV_E_SUCCESS) return -1;
+    const struct irecv_device_info *d = irecv_get_device_info(r);
+    int mode = 0;
+    irecv_get_mode(r, &mode);
+    if (!d || d->ecid != c->ecid || d->cpid != 0x8002 || d->bdid != 0x12 ||
+        mode != IRECV_K_RECOVERY_MODE_2 || !(d->ibfl & IBOOT_FLAG_IMAGE4_AWARE)) {
+        irecv_close(r); return -1;
+    }
+    c->recovery = calloc(1, sizeof(*c->recovery));
+    if (!c->recovery) { irecv_close(r); return -1; }
+    c->recovery->client = r;
+    c->image4supported = 1;
+    c->mode = MODE_RECOVERY;
+    if (irecv_devices_get_device_by_client(r, &c->device) != IRECV_E_SUCCESS ||
+        !c->device || strcmp(c->device->hardware_model, "x619ap")) {
+        recovery_client_free(c); return -1;
+    }
+    return 0;
+}
+
+static int fresh_tss(struct idevicerestore_client_t *c, plist_t identity)
+{
+    const struct irecv_device_info *d = irecv_get_device_info(c->recovery->client);
+    if (!d || !d->ap_nonce || !d->ap_nonce_size || !d->sep_nonce || !d->sep_nonce_size) return -1;
+    free(c->nonce);
+    c->nonce = malloc(d->ap_nonce_size);
+    if (!c->nonce) return -1;
+    memcpy(c->nonce, d->ap_nonce, d->ap_nonce_size);
+    c->nonce_size = d->ap_nonce_size;
+    plist_free(c->tss); c->tss = NULL;
+    return get_tss_response(c, identity, &c->tss);
+}
+
+static int component(struct idevicerestore_client_t *c, plist_t identity,
+                     const char *name, void **data, size_t *size)
+{
+    char *path = NULL; void *raw = NULL; size_t raw_size = 0;
+    *data = NULL; *size = 0;
+    if (build_identity_get_component_path(identity, name, &path)) return -1;
+    int rc = extract_component(c->ipsw, path, &raw, &raw_size);
+    free(path);
+    if (rc) return -1;
+    rc = personalize_component(c, name, raw, raw_size, c->tss, data, size);
+    free(raw);
+    return rc || !*data || !*size ? -1 : 0;
+}
+
+static plist_t capture_pair(struct idevicerestore_client_t *c, plist_t identity)
+{
+    const char *names[] = {"OSRamdisk", "KernelCache", "DeviceTree", "SEP"};
+    unsigned char *ticket = NULL; unsigned int ticket_len = 0;
+    if (tss_response_get_ap_img4_ticket(c->tss, &ticket, &ticket_len) || !ticket_len) return NULL;
+    void *image = NULL; size_t image_len = 0;
+    for (int i = 0; i < 4; i++) {
+        void *data = NULL; size_t size = 0;
+        if (component(c, identity, names[i], &data, &size) || size > 64 * 1024 * 1024 ||
+            image_len + size > 96 * 1024 * 1024) { free(data); free(image); free(ticket); return NULL; }
+        void *next = realloc(image, image_len + size);
+        if (!next) { free(data); free(image); free(ticket); return NULL; }
+        image = next;
+        memcpy((char *)image + image_len, data, size); image_len += size;
+        free(data);
+    }
+    plist_t p = plist_new_dict();
+    plist_dict_set_item(p, "FormatVersion", plist_new_uint(1));
+    plist_dict_set_item(p, "ECID", plist_new_uint(c->ecid));
+    plist_dict_set_item(p, "Model", plist_new_string("x619ap"));
+    plist_dict_set_item(p, "Build", plist_new_string("14Y901"));
+    plist_dict_set_item(p, "Image", plist_new_data(image, image_len));
+    plist_dict_set_item(p, "Ticket", plist_new_data((char *)ticket, ticket_len));
+    plist_dict_set_item(p, "RestoreFinished", plist_new_bool(0));
+    free(image); free(ticket);
+    if (t1_validate_pair(p, c->ecid)) { plist_free(p); return NULL; }
+    return p;
+}
+
+struct events { uint64_t ecid; atomic_int removed; atomic_int returned; };
+static void event_cb(const irecv_device_event_t *event, void *user)
+{
+    struct events *s = user;
+    if (!event->device_info || event->device_info->ecid != s->ecid) return;
+    if (event->type == IRECV_DEVICE_REMOVE) atomic_store(&s->removed, 1);
+    if (event->type == IRECV_DEVICE_ADD && atomic_load(&s->removed)) atomic_store(&s->returned, 1);
+}
+
+static int boot_ibec(struct idevicerestore_client_t *c, plist_t identity)
+{
+    struct events s = {.ecid = c->ecid};
+    irecv_device_event_context_t ctx = NULL;
+    if (irecv_device_event_subscribe(&ctx, event_cb, &s) != IRECV_E_SUCCESS) return -1;
+    int rc = recovery_send_component(c, identity, "iBEC");
+    if (!rc) rc = strict_command(c->recovery->client, "go", 1);
+    recovery_client_free(c);
+    for (int i = 0; !rc && !atomic_load(&s.returned) && i < 60; i++) {
+        if (c->flags & FLAG_QUIT) { rc = -1; break; }
+        sleep(1);
+    }
+    if (!atomic_load(&s.returned)) rc = -1;
+    irecv_device_event_unsubscribe(ctx);
+    return rc ? -1 : open_recovery(c);
+}
+
+static int boot_restore(struct idevicerestore_client_t *c, plist_t identity)
+{
+    if (strict_command(c->recovery->client, "setenv auto-boot false", 0) ||
+        strict_command(c->recovery->client, "saveenv", 0) ||
+        send_component_command(c, identity, "RestoreRamDisk", "ramdisk") ||
+        send_component_command(c, identity, "RestoreDeviceTree", "devicetree") ||
+        send_component_command(c, identity, "RestoreSEP", "rsepfirmware") ||
+        recovery_send_component(c, identity, "RestoreKernelCache")) return -1;
+    irecv_client_t r = c->recovery->client;
+    if (strict_command(r, "setenv boot-args rd=md0 -restore IOUSBDeviceController-configuration=standardMuxOnly", 0) ||
+        strict_command(r, "bootx", 1)) return -1;
+    recovery_client_free(c);
+    for (int i = 0; i < 120 && !(c->flags & FLAG_QUIT); i++) {
+        if (!restore_check_mode(c)) { c->mode = MODE_RESTORE; return 0; }
+        sleep(1);
+    }
+    return -1;
+}
+
+static int root_ticket(struct idevicerestore_client_t *c, plist_t fdr)
+{
+    plist_t ticket = plist_dict_get_item(c->tss, "ApImg4Ticket");
+    if (!PLIST_IS_DATA(ticket)) return -1;
+    plist_t reply = plist_new_dict();
+    plist_dict_set_item(reply, "RootTicketData", plist_copy(ticket));
+    if (fdr) plist_dict_set_item(reply, "FDRMemoryStoreData", plist_copy(fdr));
+    return send_dict(c, reply);
+}
+
+static int restore_session(struct idevicerestore_client_t *c, plist_t identity, int fd, plist_t input)
+{
+    if (restore_open_with_timeout(c)) return -1;
+    c->restore->build_identity = identity;
+    plist_t hw = NULL;
+    int valid = restored_query_value(c->restore->client, "HardwareInfo", &hw) == RESTORE_E_SUCCESS &&
+        plist_dict_get_uint(hw, "ChipID") == 0x8002 && plist_dict_get_uint(hw, "BoardID") == 0x12 &&
+        plist_dict_get_uint(hw, "UniqueChipID") == c->ecid;
+    plist_free(hw);
+    if (!valid) return -1;
+    reverse_proxy_client_t proxy = NULL;
+    int proxy_ok = 0;
+    for (int version = 2; version >= 1; version--) {
+        if (reverse_proxy_client_create_with_port(c->restore->device, &proxy, REVERSE_PROXY_DEFAULT_PORT) == REVERSE_PROXY_E_SUCCESS &&
+            reverse_proxy_client_start_proxy(proxy, version) == REVERSE_PROXY_E_SUCCESS) { proxy_ok = 1; break; }
+        if (proxy) reverse_proxy_client_free(proxy);
+        proxy = NULL;
+    }
+    if (!proxy_ok) return -1;
+    plist_t opts = t1_restore_options();
+    int rc = -1, commits = 0;
+    if (restored_start_restore(c->restore->client, opts, c->restore->protocol_version) != RESTORE_E_SUCCESS) goto done;
+    status("phase 11 started; firmware-only restore");
+    time_t deadline = time(NULL) + 15 * 60;
+    while (!(c->flags & FLAG_QUIT) && time(NULL) < deadline) {
+        plist_t msg = NULL;
+        restored_error_t err = restored_receive(c->restore->client, &msg);
+#ifdef HAVE_RESTORE_E_RECEIVE_TIMEOUT
+        if (err == RESTORE_E_RECEIVE_TIMEOUT) { plist_free(msg); continue; }
+#endif
+        if (err != RESTORE_E_SUCCESS || !PLIST_IS_DICT(msg)) { plist_free(msg); break; }
+        const char *type = plist_get_string_ptr(plist_dict_get_item(msg, "MsgType"), NULL);
+        int result = -1, finished = 0;
+        if (type && !strcmp(type, "DataRequestMsg")) {
+            const char *request = plist_get_string_ptr(plist_dict_get_item(msg, "DataType"), NULL);
+            if (t1_request_allowed(request) && !plist_dict_get_item(msg, "DataPort")) {
+                status(request);
+                if (!strcmp(request, "FDRMemoryCommit")) {
+                    result = t1_fdr_commit(fd, msg);
+                    if (!result) { commits++; result = send_dict(c, plist_new_dict()); }
+                } else if (!strcmp(request, "RootTicket")) result = root_ticket(c, input);
+                else result = restore_handle_data_request_msg(c, msg);
+            }
+        } else if (type && !strcmp(type, "StatusMsg")) {
+            plist_t code = plist_dict_get_item(msg, "Status");
+            plist_t amr = plist_dict_get_item(msg, "AMRError");
+            if (PLIST_IS_UINT(code) && plist_dict_get_uint(msg, "Status") == 0 &&
+                (!amr || PLIST_IS_UINT(amr)) &&
+                plist_dict_get_uint(msg, "AMRError") == 0 && commits > 0) {
+                plist_t ack = plist_new_dict();
+                plist_dict_set_item(ack, "MsgType", plist_new_string("ReceivedFinalStatusMsg"));
+                result = send_dict(c, ack); finished = !result;
+            }
+        } else if (type && !strcmp(type, "ProgressMsg")) {
+            result = 0;
+        } else if (type && !strcmp(type, "CheckpointMsg")) {
+            plist_t code = plist_dict_get_item(msg, "CHECKPOINT_RESULT");
+            int64_t n = -1;
+            if (PLIST_IS_INT(code)) plist_get_int_val(code, &n);
+            result = n == 0 ? 0 : -1;
+        } else if (type && !strcmp(type, "PreviousRestoreLogMsg")) {
+            /* Diagnostic text is never needed to advance the restore. */
+            result = 0;
+        }
+        if (result) {
+            /* Retain unknown messages privately for schema review; do not ACK. */
+            save_plist(fd, "unhandled-message.plist", msg);
+            status("stopped on an error or unsupported message; private evidence saved");
+        }
+        plist_free(msg);
+        if (result) break;
+        if (finished) { rc = 0; break; }
+    }
+ done:
+    plist_free(opts);
+    reverse_proxy_client_free(proxy);
+    return rc;
+}
+
+static int replay_command(void *r, const char *cmd, int breq)
+{
+    return strict_command(r, cmd, breq);
+}
+
+static int replay_buffer(void *r, const void *data, size_t size)
+{
+    if (global_quit_flag) return -1;
+    return irecv_send_buffer(r, (unsigned char *)data, size, 0) == IRECV_E_SUCCESS ? 0 : -1;
+}
+
+static int replay(struct idevicerestore_client_t *c, int fd)
+{
+    plist_t pair = read_plist(fd, "preflight.plist");
+    int rc = t1_replay_dispatch(pair, c->ecid, time(NULL), c->recovery->client,
+                                replay_command, replay_buffer);
+    if (!rc) status("phase 14 dispatched; this does not prove the T1 booted");
+    plist_free(pair);
+    return rc;
+}
+
+int t1_start(struct idevicerestore_client_t *c)
+{
+    const char *mode = getenv("IDEVICERESTORE_T1_MODE");
+    const char *private_path = getenv("IDEVICERESTORE_T1_PRIVATE");
+    const char *input_path = getenv("IDEVICERESTORE_T1_FDR_INPUT_DIR");
+    if (!c || !mode || (strcmp(mode, "inspect") && strcmp(mode, "provision") && strcmp(mode, "replay"))) {
+        fprintf(stderr, "T1 requires IDEVICERESTORE_T1_MODE=inspect|provision|replay. Legacy research flags are unsupported.\n"); return -1;
+    }
+    /* Reject misspelled or inherited research controls, rather than ignore them. */
+    const char *allowed[] = {"IDEVICERESTORE_T1_MODE=", "IDEVICERESTORE_T1_PRIVATE=", "IDEVICERESTORE_T1_FDR_INPUT_DIR=", NULL};
+    for (char **p = environ; p && *p; p++) {
+        if (strncmp(*p, "IDEVICERESTORE_", 15)) continue;
+        int ok = 0;
+        for (int i = 0; allowed[i]; i++) if (!strncmp(*p, allowed[i], strlen(allowed[i]))) ok = 1;
+        if (!ok) { fprintf(stderr, "Unsupported IDEVICERESTORE environment control.\n"); return -1; }
+    }
+    if (!c->ipsw || c->debug_level || c->tss_url || c->udid ||
+        (c->restore_variant && strcmp(c->restore_variant, "Customer Boot")) ||
+        (c->flags & ~(FLAG_INTERACTIVE | FLAG_IN_PROGRESS))) {
+        fprintf(stderr, "T1 rejects generic restore/debug/custom-server options.\n"); return -1;
+    }
+    int enabled = 0;
+    if (ipsw_extract_build_manifest(c->ipsw, &c->build_manifest, &enabled)) return -1;
+    plist_t identity = build_manifest_get_build_identity_for_model_with_variant(c->build_manifest, "x619ap", "Customer Boot", 1);
+    if (!t1_identity_valid(c->build_manifest, identity)) { fprintf(stderr, "T1 firmware identity rejected.\n"); return -1; }
+    const char *required[] = {"iBEC", "LLB", "iBoot", "OSRamdisk", "KernelCache", "DeviceTree", "SEP", "RestoreRamDisk", "RestoreKernelCache", "RestoreDeviceTree", "RestoreSEP", NULL};
+    for (int i = 0; required[i]; i++) {
+        char *path = NULL;
+        if (build_identity_get_component_path(identity, required[i], &path)) return -1;
+        int present = path[0] != '/' && !strstr(path, "..") && ipsw_file_exists(c->ipsw, path);
+        free(path);
+        if (!present) { fprintf(stderr, "T1 firmware component missing.\n"); return -1; }
+    }
+    if (!strcmp(mode, "inspect")) {
+        puts("T1 offline inspection passed: x619ap, 14Y901; required components present. No USB/network operations."); return 0;
+    }
+    if (geteuid() != 0 || !c->ecid || !private_path || (!strcmp(mode, "replay") && input_path)) {
+        fprintf(stderr, "T1 live modes require root, explicit -i ECID, and a private directory; replay uses only its captured pair.\n"); return -1;
+    }
+    int fd = t1_private_open(private_path);
+    if (fd < 0) { fprintf(stderr, "T1 private directory must exist, be owned by root, mode 0700, without symlinks.\n"); return -1; }
+    const char *logname = !strcmp(mode, "replay") ? "replay.private.log" : "provision.private.log";
+    int logfd = openat(fd, logname, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600);
+    status_fd = dup(STDOUT_FILENO);
+    if (logfd < 0 || status_fd < 0) { if (logfd >= 0) close(logfd); close(fd); if (status_fd >= 0) close(status_fd); status_fd = -1; return -1; }
+    fflush(NULL);
+    int saved_err = dup(STDERR_FILENO);
+    if (saved_err < 0 || dup2(logfd, STDOUT_FILENO) < 0 || dup2(logfd, STDERR_FILENO) < 0) {
+        if (saved_err >= 0) { dup2(saved_err, STDERR_FILENO); close(saved_err); }
+        dup2(status_fd, STDOUT_FILENO); close(status_fd); status_fd = -1; close(logfd); close(fd); return -1;
+    }
+    close(logfd);
+    mode_t previous_umask = umask(077);
+    int rc = -1; plist_t pair = NULL, input = NULL;
+    status("experimental mode; logs are private");
+    if (input_path) {
+        int in = t1_private_open(input_path);
+        if (in < 0) goto done;
+        plist_t provenance = read_plist(in, "device.plist");
+        input = read_plist(in, "FDRData");
+        close(in);
+        int same = provenance && plist_dict_get_uint(provenance, "ECID") == c->ecid;
+        plist_free(provenance);
+        if (!same || !PLIST_IS_DICT(input) || !plist_dict_get_size(input)) goto done;
+    }
+    if (open_recovery(c)) { status("target rejected or not in T1 recovery"); goto done; }
+    if (!strcmp(mode, "replay")) { rc = replay(c, fd); goto done; }
+    plist_t provenance = plist_new_dict();
+    plist_dict_set_item(provenance, "ECID", plist_new_uint(c->ecid));
+    int saved = save_plist(fd, "device.plist", provenance);
+    plist_free(provenance);
+    if (saved) goto done;
+    build_manifest_get_version_information(c->build_manifest, c);
+    c->parameters = plist_new_dict();
+    tss_parameters_add_from_manifest(c->parameters, identity, true);
+    if (fresh_tss(c, identity) || boot_ibec(c, identity) || fresh_tss(c, identity)) goto done;
+    pair = capture_pair(c, identity);
+    if (!pair || save_plist(fd, "preflight.plist", pair)) goto done;
+    status("saved matching personalized image and ticket; restore still pending");
+    if (boot_restore(c, identity) || restore_session(c, identity, fd, input)) goto done;
+    if (input) {
+        plist_t output = read_plist(fd, "FDRData");
+        char *ib = NULL, *ob = NULL; uint32_t il = 0, ol = 0;
+        plist_to_bin(input, &ib, &il);
+        if (output) plist_to_bin(output, &ob, &ol);
+        int same = ib && ob && il == ol && !memcmp(ib, ob, il);
+        plist_mem_free(ib); plist_mem_free(ob);
+        plist_free(output);
+        if (!same) { status("FDR replay differs; phase 14 disabled"); goto done; }
+    }
+    plist_dict_set_item(pair, "RestoreFinished", plist_new_bool(1));
+    plist_dict_set_item(pair, "FDRReplayed", plist_new_bool(input != NULL));
+    plist_dict_set_item(pair, "FinishedAt", plist_new_uint(time(NULL)));
+    if (save_plist(fd, "preflight.plist", pair)) goto done;
+    status("phase 11 finished; no reset, reboot, or EFI staging performed");
+    rc = 0;
+ done:
+    recovery_client_free(c);
+    restore_client_free(c);
+    plist_free(pair); plist_free(input);
+    plist_free(c->parameters); c->parameters = NULL;
+    plist_free(c->tss); c->tss = NULL;
+    if (rc) status("operation stopped; examine the private log before retrying");
+    fflush(NULL);
+    dup2(status_fd, STDOUT_FILENO); dup2(saved_err, STDERR_FILENO);
+    close(status_fd); status_fd = -1; close(saved_err); close(fd);
+    umask(previous_umask);
+    return rc;
+}
