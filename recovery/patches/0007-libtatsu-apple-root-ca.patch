From 68c647dc5c99f2c0cb3c1375bd046a841c7392ec Mon Sep 17 00:00:00 2001
From: Kerim Incedayi <k@kerim.me>
Date: Tue, 8 Sep 2026 12:16:56 +0200
Subject: [PATCH] Trust official Apple Root CA only for verified T1 signing

---
 src/Makefile.am          |  1 +
 src/apple_root_ca.h      | 35 +++++++++++++++++++++++++++++++++++
 src/tss.c                |  5 ++++-
 tests/secure_transport.c | 10 ++++++++--
 4 files changed, 48 insertions(+), 3 deletions(-)
 create mode 100644 src/apple_root_ca.h

diff --git a/src/Makefile.am b/src/Makefile.am
index 24acfcf..c02fd8f 100644
--- a/src/Makefile.am
+++ b/src/Makefile.am
@@ -10,6 +10,7 @@ libtatsu_la_LIBADD =
 libtatsu_la_SOURCES =	\
 	tss.c \
 	tatsu.c \
+	apple_root_ca.h \
 	common.h
 
 if WIN32
diff --git a/src/apple_root_ca.h b/src/apple_root_ca.h
new file mode 100644
index 0000000..bd93a6c
--- /dev/null
+++ b/src/apple_root_ca.h
@@ -0,0 +1,35 @@
