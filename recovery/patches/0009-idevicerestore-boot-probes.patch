+def probe_dispatch(data, ticket=TICKET, fail_at=None):
+    calls=[]
+    def cmd(_, name, breq):
+        calls.append(('command',name.decode(),breq))
+        return -1 if len(calls)==fail_at else 0
+    def buf(_, ptr, size):
+        calls.append(('buffer',C.string_at(ptr,size)))
+        return -1 if len(calls)==fail_at else 0
+    rc=lib.t1_restore_probe_dispatch(data,len(data),ticket,len(ticket),None,COMMAND(cmd),BUFFER(buf))
+    return rc,calls
+
+class RestoreBootProbe(unittest.TestCase):
+    def setUp(self):
+        self.data=b''.join(image(t) for t in ('rdsk','rkrn','rdtr','rsep'))
+    def test_only_restore_boot_commands(self):
+        rc,calls=probe_dispatch(self.data)
+        self.assertEqual(rc,0)
+        self.assertEqual(calls,[('command','setenv auto-boot false',0),('command','saveenv',0),
+            ('buffer',self.data),
+            ('command','setenv boot-args rd=md0 -restore IOUSBDeviceController-configuration=standardMuxOnly',0),
+            ('command','memboot',1)])
+    def test_every_failed_transfer_stops_dispatch(self):
+        for n in range(1,6):
+            rc,calls=probe_dispatch(self.data,fail_at=n)
+            self.assertEqual(rc,-1)
+            self.assertEqual(len(calls),n)
+    def test_reject_wrong_image_or_ticket_before_any_command(self):
+        for data in [pair()['Image'],self.data+b'padding',b'2GMI'+self.data,
+                     image('rdsk',TICKET+b'wrong')+b''.join(image(t) for t in ('rkrn','rdtr','rsep'))]:
+            self.assertEqual(probe_dispatch(data),(-1,[]))
+        self.assertEqual(probe_dispatch(self.data,ticket=TICKET+b'wrong'),(-1,[]))
+    def test_reject_every_truncation_before_any_command(self):
+        for n in range(len(self.data)):
+            self.assertEqual(probe_dispatch(self.data[:n]),(-1,[]))
+
