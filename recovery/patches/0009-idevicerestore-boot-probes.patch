         send_component_command(c, identity, "RestoreSEP", "rsepfirmware") ||
         recovery_send_component(c, identity, "RestoreKernelCache")) return -1;
@@ -318,13 +407,54 @@ static int replay(struct idevicerestore_client_t *c, int fd)
     return rc;
 }
 
+static int memboot_probe(struct idevicerestore_client_t *c, plist_t identity, int fd)
+{
+    const char *names[] = {"RestoreRamDisk", "RestoreKernelCache", "RestoreDeviceTree", "RestoreSEP"};
+    void *image = NULL; size_t image_size = 0;
+    unsigned char *ticket = NULL; unsigned int ticket_size = 0;
+    int rc = -1;
+    if (tss_response_get_ap_img4_ticket(c->tss, &ticket, &ticket_size)) goto done;
+    for (int i = 0; i < 4; i++) {
+        void *data = NULL; size_t size = 0;
+        if (component(c, identity, names[i], &data, &size) || size > 64 * 1024 * 1024 ||
+            image_size + size > 96 * 1024 * 1024) { free(data); goto done; }
+        void *next = realloc(image, image_size + size);
+        if (!next) { free(data); goto done; }
+        image = next;
+        memcpy((char *)image + image_size, data, size); image_size += size;
+        free(data);
+    }
+    if (t1_atomic_write(fd, "restore-probe.img4", image, image_size)) goto done;
+    status("testing signed combined restore image; no restore session will be started");
+    rc = t1_restore_probe_dispatch(image, image_size, ticket, ticket_size,
+        c->recovery->client, replay_command, replay_buffer);
+    if (rc) { drain_console(c->recovery->client); goto done; }
+    recovery_client_free(c);
+    rc = -1;
+    for (int i = 0; i < 60 && !global_quit_flag; i++) {
+        if (!restore_check_mode(c)) {
+            c->mode = MODE_RESTORE;
+            status("combined restore image booted; provisioning has not started");
+            rc = 0; break;
+        }
+        sleep(1);
+    }
+    if (rc) {
+        status("combined restore image did not reach restored");
+        if (!open_recovery(c)) drain_console(c->recovery->client);
+    }
+ done:
+    free(image); free(ticket);
+    return rc;
+}
