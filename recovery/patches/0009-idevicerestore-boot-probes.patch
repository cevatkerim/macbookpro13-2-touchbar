+
+/* Experimental restore boot, distinct from completed production-image replay.
+ * Each restore IMG4 carries its ticket. No raw ticket command, NOR write,
+ * restored StartRestore request, FDR acknowledgement, or EFI operation here.
+ * Whether T1 accepts this concatenation for restore is a hardware hypothesis.
+ */
+int t1_restore_probe_dispatch(const void *image, size_t image_size,
+    const void *ticket, size_t ticket_size, void *transport,
+    t1_command_fn command, t1_buffer_fn buffer)
+{
+    if (!command || !buffer || !image || !image_size || image_size > T1_MAX_FILE ||
+        !ticket || !ticket_size || ticket_size > 1024 * 1024) return -1;
+    const unsigned char *p = image, *end = p + image_size;
+    const char *tags[] = {"rdsk", "rkrn", "rdtr", "rsep"};
+    for (int i = 0; i < 4; i++) {
+        const unsigned char *start = p, *v; size_t n;
+        if (der(&p, end, 0x30, &v, &n) ||
+            t1_validate_img4(start, p - start, tags[i], ticket, ticket_size)) return -1;
+    }
+    if (p != end) return -1;
+    if (command(transport, "setenv auto-boot false", 0) ||
+        command(transport, "saveenv", 0) || buffer(transport, image, image_size) ||
+        command(transport, "setenv boot-args rd=md0 -restore IOUSBDeviceController-configuration=standardMuxOnly", 0) ||
+        command(transport, "memboot", 1)) return -1;
+    return 0;
+}
