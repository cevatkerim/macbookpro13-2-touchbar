@@ -172,6 +172,58 @@ static void event_cb(const irecv_device_event_t *event, void *user)
     if (event->type == IRECV_DEVICE_ADD && atomic_load(&s->removed)) atomic_store(&s->returned, 1);
 }
 
+static size_t console_bytes;
+static int private_console(irecv_client_t client, const irecv_event_t *event)
+{
+    (void)client;
+    if (event->size <= 0 || event->size > 4096 || console_bytes + event->size > 65536) return 1;
+    fwrite(event->data, 1, event->size, stderr);
+    console_bytes += event->size;
+    return 0;
+}
+
+static void drain_console(irecv_client_t r)
+{
+    console_bytes = 0;
+    if (irecv_event_subscribe(r, IRECV_RECEIVED, private_console, NULL) == IRECV_E_SUCCESS) {
+        irecv_receive(r);
+        irecv_event_unsubscribe(r, IRECV_RECEIVED);
+    }
+}
+
+/* Do not read a stale response after a rejected getenv command. */
+static int checked_getenv(irecv_client_t r, const char *name, char value[256])
+{
+    char command[128];
+    snprintf(command, sizeof(command), "getenv %s", name);
+    value[0] = 0;
+    if (strict_command(r, command, 0)) return -1;
+    int n = irecv_usb_control_transfer(r, 0xc0, 0, 0, 0,
+        (unsigned char *)value, 255, 3000);
+    if (n <= 0 || n > 255) return -1;
+    value[n] = 0;
+    return value[0] ? 0 : -1;
+}
+
+static int wait_ibec_ready(struct idevicerestore_client_t *c)
+{
+    for (int attempt = 0; attempt < 30 && !global_quit_flag; attempt++) {
+        char value[256];
+        if (!checked_getenv(c->recovery->client, "build-version", value)) {
+            fprintf(stderr, "T1 iBEC build-version: %s\n", value);
+            drain_console(c->recovery->client);
+            status("iBEC readiness query passed");
+            return 0;
+        }
+        drain_console(c->recovery->client);
+        sleep(1);
+        recovery_client_free(c);
+        if (open_recovery(c)) return -1;
+    }
+    status("iBEC readiness query failed; no restore ramdisk uploaded");
+    return -1;
+}
+
 static int boot_ibec(struct idevicerestore_client_t *c, plist_t identity)
 {
     struct events s = {.ecid = c->ecid};
@@ -186,14 +238,51 @@ static int boot_ibec(struct idevicerestore_client_t *c, plist_t identity)
     }
     if (!atomic_load(&s.returned)) rc = -1;
     irecv_device_event_unsubscribe(ctx);
-    return rc ? -1 : open_recovery(c);
+    if (rc || open_recovery(c)) return -1;
+    return wait_ibec_ready(c);
+}
+
+static int send_restore_ramdisk(struct idevicerestore_client_t *c, plist_t identity)
+{
+    void *data = NULL; size_t size = 0;
+    unsigned char *ticket = NULL; unsigned int ticket_size = 0;
+    char value[256];
+    if (component(c, identity, "RestoreRamDisk", &data, &size) ||
+        tss_response_get_ap_img4_ticket(c->tss, &ticket, &ticket_size) ||
+        t1_validate_img4(data, size, "rdsk", ticket, ticket_size)) {
+        free(data); free(ticket); return -1;
+    }
+    free(ticket);
+    if (!checked_getenv(c->recovery->client, "ramdisk-size", value))
+        fprintf(stderr, "T1 ramdisk capacity: %s\n", value);
+    fprintf(stderr, "T1 restore ramdisk upload bytes: %zu\n", size);
+    int sent = irecv_send_buffer(c->recovery->client, data, size, 0);
+    free(data);
+    if (sent != IRECV_E_SUCCESS) return -1;
+    /* Querying the upload length also lets iBoot finish its bulk receive loop. */
+    if (!checked_getenv(c->recovery->client, "filesize", value)) {
+        char *end = NULL;
+        unsigned long long received = strtoull(value, &end, 0);
+        fprintf(stderr, "T1 reported upload bytes: %llu\n", received);
+        if (!end || *end || received != size) {
+            status("T1 reported a different upload length; ramdisk command withheld");
+            return -1;
+        }
+    }
+    /* The upstream ramdisk sequence queries this optional delay variable. */
+    checked_getenv(c->recovery->client, "ramdisk-delay", value);
+    sleep(1);
+    int rc = strict_command(c->recovery->client, "ramdisk", 0);
+    sleep(2);
+    drain_console(c->recovery->client);
+    return rc;
 }
 
 static int boot_restore(struct idevicerestore_client_t *c, plist_t identity)
 {
     if (strict_command(c->recovery->client, "setenv auto-boot false", 0) ||
         strict_command(c->recovery->client, "saveenv", 0) ||
-        send_component_command(c, identity, "RestoreRamDisk", "ramdisk") ||
