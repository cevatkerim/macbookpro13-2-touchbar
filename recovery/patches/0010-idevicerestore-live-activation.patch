new file mode 100644
index 0000000..a62921c
--- /dev/null
+++ b/tests/restored_harness.c
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "../src/t1.c"
+#include <assert.h>
+struct idevicerestore_mode_t idevicerestore_modes[7];
+static int scenario, opened, closed;
+static char dev, conn;
+idevice_error_t idevice_get_device_list(char ***devices, int *count)
+{ *count=1; *devices=calloc(2,sizeof(char*)); (*devices)[0]=strdup("fixture"); return IDEVICE_E_SUCCESS; }
+idevice_error_t idevice_device_list_free(char **devices)
+{ free(devices[0]); free(devices); return IDEVICE_E_SUCCESS; }
+idevice_error_t idevice_new(idevice_t *d, const char *udid)
+{ assert(!strcmp(udid,"fixture")); *d=(idevice_t)&dev; return IDEVICE_E_SUCCESS; }
+idevice_error_t idevice_free(idevice_t d)
+{ assert(d==(idevice_t)&dev); return IDEVICE_E_SUCCESS; }
+restored_error_t restored_client_new(idevice_t d, restored_client_t *r, const char *label)
+{ (void)label; assert(d==(idevice_t)&dev); opened++; if(scenario==1)return RESTORE_E_MUX_ERROR; *r=(restored_client_t)&conn; return RESTORE_E_SUCCESS; }
+restored_error_t restored_client_free(restored_client_t r)
+{ assert(r==(restored_client_t)&conn); closed++; return RESTORE_E_SUCCESS; }
+restored_error_t restored_query_type(restored_client_t r, char **type, uint64_t *version)
+{ (void)r; *type=strdup(scenario==2?"wrong.service":"com.apple.mobile.restored"); *version=14; return RESTORE_E_SUCCESS; }
+restored_error_t restored_query_value(restored_client_t r, const char *key, plist_t *hw)
+{ (void)r; assert(!strcmp(key,"HardwareInfo")); *hw=plist_new_dict();
+  plist_dict_set_item(*hw,"ChipID",plist_new_uint(scenario==3?0:0x8002));
+  plist_dict_set_item(*hw,"BoardID",plist_new_uint(scenario==4?0:0x12));
+  plist_dict_set_item(*hw,"UniqueChipID",plist_new_uint(scenario==5?456:123)); return RESTORE_E_SUCCESS; }
+int main(void)
+{
+ for(scenario=0;scenario<6;scenario++) {
+  opened=closed=0; struct idevicerestore_client_t c={.ecid=123};
+  int rc=t1_open_restored(&c); assert((rc==0)==(scenario==0));
+  if(!scenario) {
+   assert(opened==1 && closed==0 && c.restore && c.restore->protocol_version==14);
+   assert(!t1_open_restored(&c)); assert(opened==1 && closed==0);
+   restored_client_free(c.restore->client); idevice_free(c.restore->device); free(c.restore); free(c.udid);
+  } else assert(!c.restore && !c.udid && closed==(scenario!=1));
+ }
+ return 0;
+}
