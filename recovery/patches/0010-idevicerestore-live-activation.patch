new file mode 100644
index 0000000..5257437
--- /dev/null
+++ b/tests/ibec_harness.c
@@ -0,0 +1,76 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * Exercise the actual bootstrap controller with a simulated USB device.
+ * No real USB implementation or firmware sender is linked into this harness.
+ */
+#include "../src/t1.c"
+#include <assert.h>
+
+int global_quit_flag;
+struct idevicerestore_mode_t idevicerestore_modes[7];
+static struct irecv_device_info device_info = {.ecid=123,.cpid=0x8002,.bdid=0x12};
+static struct irecv_device device = {.hardware_model="x619ap"};
+static irecv_device_event_cb_t callback;
+static void *callback_user;
+static int uploaded, waited, started, opened, failure;
+static char handle;
+
+unsigned int sleep(unsigned int seconds) { waited += seconds; return 0; }
+const struct irecv_device_info *irecv_get_device_info(irecv_client_t r)
+{ (void)r; return &device_info; }
+irecv_error_t irecv_open_with_ecid(irecv_client_t *r, uint64_t ecid)
+{ assert(ecid==123); *r=(irecv_client_t)&handle; opened++; return IRECV_E_SUCCESS; }
+irecv_error_t irecv_close(irecv_client_t r)
+{ (void)r; return IRECV_E_SUCCESS; }
+irecv_error_t irecv_get_mode(irecv_client_t r, int *mode)
+{ (void)r; *mode=IRECV_K_RECOVERY_MODE_2; return IRECV_E_SUCCESS; }
+irecv_error_t irecv_devices_get_device_by_client(irecv_client_t r, irecv_device_t *d)
+{ (void)r; *d=&device; return IRECV_E_SUCCESS; }
+void recovery_client_free(struct idevicerestore_client_t *c)
+{ free(c->recovery); c->recovery=NULL; }
+int recovery_send_component(struct idevicerestore_client_t *c, plist_t identity, const char *name)
+{ (void)c; (void)identity; assert(!strcmp(name,"iBEC")); uploaded++; return failure==1?-1:0; }
+irecv_error_t irecv_device_event_subscribe(irecv_device_event_context_t *ctx,
+    irecv_device_event_cb_t cb, void *user)
+{ *ctx=(irecv_device_event_context_t)&handle; callback=cb; callback_user=user; return IRECV_E_SUCCESS; }
+irecv_error_t irecv_device_event_unsubscribe(irecv_device_event_context_t ctx)
+{ (void)ctx; callback=NULL; return IRECV_E_SUCCESS; }
+irecv_error_t irecv_event_subscribe(irecv_client_t r, irecv_event_type t, irecv_event_cb_t cb, void *user)
+{ (void)r; (void)t; (void)cb; (void)user; return IRECV_E_SUCCESS; }
+irecv_error_t irecv_event_unsubscribe(irecv_client_t r, irecv_event_type t)
+{ (void)r; (void)t; return IRECV_E_SUCCESS; }
+irecv_error_t irecv_receive(irecv_client_t r)
+{ (void)r; return IRECV_E_SUCCESS; }
+int irecv_usb_control_transfer(irecv_client_t r, uint8_t type, uint8_t request,
+    uint16_t value, uint16_t index, unsigned char *data, uint16_t length, unsigned int timeout)
+{
+    (void)r; (void)timeout; assert(!value && !index);
+    if (type==0xc0) {
+        assert(request==0 && length>=7); memcpy(data,"fixture",7); return 7;
+    }
+    assert(type==0x40 && length==strlen((char*)data)+1);
+    if (!strcmp((char*)data,"go")) {
+        assert(uploaded==1 && waited>=1 && request==1); started++;
+        if (failure==2) return -9;
+        irecv_device_event_t event={.type=IRECV_DEVICE_REMOVE,.device_info=&device_info};
+        callback(&event,callback_user);
+        if (failure!=3) device_info.ibfl=0x3c;
+        event.type=IRECV_DEVICE_ADD; callback(&event,callback_user);
+    } else assert(!strcmp((char*)data,"getenv build-version") && request==0);
+    return length;
+}
+int main(void)
+{
+    for (int scenario=0;scenario<5;scenario++) {
+        failure=scenario; uploaded=waited=started=opened=0;
+        device_info.ibfl=scenario==4?0x3c:0x3d;
+        struct idevicerestore_client_t c={.ecid=123};
+        assert(!open_recovery(&c));
+        int rc=boot_ibec(&c,NULL);
+        assert((rc==0)==(scenario==0 || scenario==4));
+        if (scenario==1) assert(uploaded==1 && !started && !waited);
+        if (scenario==2 || scenario==3) assert(started==1);
+        if (scenario==4) assert(!uploaded && !started && !waited && opened==1);
+        recovery_client_free(&c);
+    }
+    return 0;
+}
