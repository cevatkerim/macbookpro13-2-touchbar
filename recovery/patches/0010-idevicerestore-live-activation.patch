+/* Keep the verified restored connection: freeing a discovery client sends
+ * Goodbye, after which this EmbeddedOS restored stops accepting connections. */
+static int t1_open_restored(struct idevicerestore_client_t *c)
+{
+    if (c->restore && c->restore->client) return 0;
+    char **devices = NULL;
+    int count = 0, result = -1;
+    if (idevice_get_device_list(&devices, &count) != IDEVICE_E_SUCCESS) return -1;
+    for (int i = 0; i < count; i++) {
+        idevice_t device = NULL;
+        restored_client_t connection = NULL;
+        char *type = NULL;
+        uint64_t version = 0;
+        plist_t hw = NULL;
+        if (idevice_new(&device, devices[i]) == IDEVICE_E_SUCCESS &&
+            restored_client_new(device, &connection, "idevicerestore") == RESTORE_E_SUCCESS &&
+            restored_query_type(connection, &type, &version) == RESTORE_E_SUCCESS &&
+            type && !strcmp(type, "com.apple.mobile.restored") &&
+            restored_query_value(connection, "HardwareInfo", &hw) == RESTORE_E_SUCCESS &&
+            plist_dict_get_uint(hw, "ChipID") == 0x8002 &&
+            plist_dict_get_uint(hw, "BoardID") == 0x12 &&
+            plist_dict_get_uint(hw, "UniqueChipID") == c->ecid) {
+            struct restore_client_t *r = calloc(1, sizeof(*r));
+            char *udid = strdup(devices[i]);
+            if (r && udid) {
+                r->device = device; r->client = connection;
+                r->protocol_version = version;
+                c->restore = r; c->udid = udid; c->mode = MODE_RESTORE;
+                device = NULL; connection = NULL; result = 0;
+            } else { free(r); free(udid); }
+        }
+        free(type); plist_free(hw);
+        if (connection) restored_client_free(connection);
+        if (device) idevice_free(device);
+        if (!result) break;
+    }
+    idevice_device_list_free(devices);
+    return result;
+}
